<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_asset_management" model="ir.module.category">
        <field name="name">Asset Management</field>
        <field name="description">FMS Asset Management roles (module #13). Independent roles; FUTURE: central RBAC (#27) maps users to these groups.</field>
        <field name="sequence">61</field>
        <field name="parent_id" ref="base.module_category_services"/>
    </record>

    <record id="group_asset_administrator" model="res.groups">
        <field name="name">Asset Administrator</field>
        <field name="comment">Full asset and master-data access. Approve configuration changes.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('maintenance.group_equipment_manager'))]"/>
        <field name="category_id" ref="module_category_asset_management"/>
        <field name="users" eval="[(4, ref('base.user_admin')), (4, ref('base.user_root'))]"/>
    </record>
    <record id="group_asset_manager" model="res.groups">
        <field name="name">Asset Manager</field>
        <field name="comment">Register and edit assets, classification, locations, and lifecycle fields.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('maintenance.group_equipment_manager'))]"/>
        <field name="category_id" ref="module_category_asset_management"/>
    </record>
    <record id="group_asset_facility_manager" model="res.groups">
        <field name="name">Facility Manager</field>
        <field name="comment">View and update permitted operational asset information.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="category_id" ref="module_category_asset_management"/>
    </record>
    <record id="group_asset_technician" model="res.groups">
        <field name="name">Technician / Operations User</field>
        <field name="comment">View assets and update permitted condition and health information.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="category_id" ref="module_category_asset_management"/>
    </record>
    <record id="group_asset_finance" model="res.groups">
        <field name="name">Finance User</field>
        <field name="comment">Read assets, manage depreciation schedules, and maintain financial fields.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="category_id" ref="module_category_asset_management"/>
    </record>
    <record id="group_asset_auditor" model="res.groups">
        <field name="name">Auditor</field>
        <field name="comment">Read-only access to assets, classification, locations, and dashboard data.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="category_id" ref="module_category_asset_management"/>
    </record>
</odoo>
