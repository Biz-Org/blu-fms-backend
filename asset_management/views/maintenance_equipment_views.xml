<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fms_asset_equipment_tree" model="ir.ui.view">
        <field name="name">fms.asset.equipment.tree</field>
        <field name="model">maintenance.equipment</field>
        <field name="arch" type="xml">
            <list>
                <field name="fms_asset_code"/>
                <field name="name"/>
                <field name="fms_classification_id"/>
                <field name="fms_location_id"/>
                <field name="fms_lifecycle_state"/>
                <field name="fms_condition"/>
                <field name="fms_health_status"/>
                <field name="serial_no"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_fms_asset_equipment_search" model="ir.ui.view">
        <field name="name">fms.asset.equipment.search</field>
        <field name="model">maintenance.equipment</field>
        <field name="arch" type="xml">
            <search>
                <field name="fms_asset_code"/>
                <field name="name"/>
                <field name="serial_no"/>
                <field name="fms_classification_id"/>
                <field name="fms_location_id"/>
                <filter string="Active" name="filter_active_lifecycle" domain="[('fms_lifecycle_state', '=', 'active')]"/>
                <filter string="Disposed" name="filter_disposed" domain="[('fms_lifecycle_state', '=', 'disposed')]"/>
                <group expand="0" string="Group By">
                    <filter string="Lifecycle" name="group_lifecycle" context="{'group_by': 'fms_lifecycle_state'}"/>
                    <filter string="Classification" name="group_classification" context="{'group_by': 'fms_classification_id'}"/>
                    <filter string="Location" name="group_location" context="{'group_by': 'fms_location_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_fms_asset_equipment_form" model="ir.ui.view">
        <field name="name">fms.asset.equipment.form</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <field name="fms_lifecycle_state" widget="statusbar" statusbar_visible="draft,active,under_maintenance,inactive,disposed"/>
                </header>
            </xpath>
            <xpath expr="//field[@name='name']" position="before">
                <field name="fms_asset_code" readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="fms_classification_id" domain="[('level', '=', 'subtype'), ('company_id', 'in', [company_id, False])]"/>
                <field name="fms_location_id" domain="[('location_type', '=', 'room'), ('company_id', 'in', [company_id, False])]"/>
                <field name="fms_manufacturer"/>
            </xpath>
            <xpath expr="//field[@name='location']" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="help">Mirrors FMS facility location complete name for Maintenance compatibility.</attribute>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="FMS Condition &amp; Health" name="fms_health">
                    <group>
                        <field name="fms_condition"/>
                        <field name="fms_health_status"/>
                        <field name="fms_operations_locked"/>
                    </group>
                    <field name="fms_image" widget="image" class="oe_avatar" options="{'preview_image': 'fms_image'}"/>
                </page>
                <page string="FMS Financial (stored)" name="fms_financial">
                    <group>
                        <group>
                            <field name="fms_acquisition_date"/>
                            <field name="fms_purchase_order_ref"/>
                            <field name="fms_invoice_ref"/>
                            <field name="cost"/>
                            <field name="fms_residual_value"/>
                            <field name="fms_currency_id"/>
                        </group>
                        <group>
                            <field name="fms_useful_life_months"/>
                            <field name="fms_depreciation_method"/>
                            <field name="fms_accumulated_depreciation" readonly="1"/>
                            <field name="fms_book_value" readonly="1"/>
                            <field name="fms_active_depreciation_schedule_id" readonly="1"/>
                            <field name="fms_current_assignment_id" readonly="1"/>
                        </group>
                    </group>
                    <field name="fms_depreciation_schedule_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="state"/>
                            <field name="method"/>
                            <field name="book_value"/>
                            <field name="accumulated_depreciation"/>
                        </list>
                    </field>
                </page>
                <page string="FMS Assignment" name="fms_assignment">
                    <field name="fms_assignment_ids" readonly="1">
                        <list>
                            <field name="assignment_type"/>
                            <field name="assigned_user_id"/>
                            <field name="department"/>
                            <field name="assignment_date"/>
                            <field name="state"/>
                        </list>
                    </field>
                    <field name="fms_assignment_history_ids" readonly="1">
                        <list>
                            <field name="event_date"/>
                            <field name="event_type"/>
                            <field name="assigned_user_id"/>
                            <field name="department"/>
                        </list>
                    </field>
                </page>
                <page string="FMS Lifecycle" name="fms_lifecycle">
                    <field name="fms_lifecycle_event_ids" readonly="1">
                        <list>
                            <field name="event_date"/>
                            <field name="event_type"/>
                            <field name="summary"/>
                            <field name="user_id"/>
                        </list>
                    </field>
                </page>
                <page string="FMS QR / Operations" name="fms_qr_ops" groups="fms_asset_management.group_asset_administrator,fms_asset_management.group_asset_manager,fms_asset_management.group_asset_facility_manager">
                    <group>
                        <field name="fms_qr_token" readonly="1"/>
                        <field name="fms_barcode"/>
                        <button name="action_fms_regenerate_qr" type="object" string="Regenerate QR" class="btn-secondary"/>
                    </group>
                    <field name="fms_warranty_ids" readonly="1">
                        <list><field name="name"/><field name="status"/><field name="end_date"/></list>
                    </field>
                    <field name="fms_transfer_ids" readonly="1">
                        <list><field name="name"/><field name="state"/><field name="scheduled_transfer_date"/></list>
                    </field>
                    <field name="fms_disposal_ids" readonly="1">
                        <list><field name="name"/><field name="state"/><field name="disposal_date"/></list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_fms_asset_equipment" model="ir.actions.act_window">
        <field name="name">Assets (Maintenance)</field>
        <field name="res_model">maintenance.equipment</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_fms_asset_equipment_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('maintenance.hr_equipment_view_form')})]"/>
        <field name="search_view_id" ref="view_fms_asset_equipment_search"/>
    </record>
</odoo>
