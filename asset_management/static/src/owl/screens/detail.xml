<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="fms_asset_management.Detail">
        <div class="o_action o_am_app">
            <AmAppShell active="'register'" title="'Asset Details'">
                <div class="o_am_shell" t-if="state.loading">
                    <div class="o_am_empty"><h3>Loading asset</h3></div>
                </div>
                <div class="o_am_shell" t-elif="state.error">
                    <div class="o_am_empty">
                        <h3 t-esc="state.error"/>
                        <button class="o_am_btn primary mt-2" t-on-click="openRegister">Asset Register</button>
                    </div>
                </div>
                <t t-else="">
                    <div class="o_am_detail_header o_am_card o_am_detail_hero">
                        <div class="d-flex justify-content-between flex-wrap gap-2">
                            <div>
                                <div class="small text-muted" t-esc="state.data.fms_asset_code"/>
                                <h1 t-esc="state.data.name"/>
                                <div class="d-flex gap-2 flex-wrap mt-1">
                                    <AmStatusBadge state="state.data.fms_lifecycle_state"/>
                                    <AmStatusBadge state="state.data.fms_condition"/>
                                    <AmStatusBadge state="state.data.fms_health_status"/>
                                </div>
                            </div>
                            <button class="o_am_btn" t-on-click="openRegister">Back</button>
                        </div>
                        <div class="o_am_tabs mt-3">
                            <button t-att-class="state.tab === 'overview' ? 'active' : ''" t-on-click="() => this.setTab('overview')">Overview</button>
                            <button t-att-class="state.tab === 'assignment' ? 'active' : ''" t-on-click="() => this.setTab('assignment')">Location &amp; Assignment</button>
                            <button t-att-class="state.tab === 'contracts' ? 'active' : ''" t-on-click="() => this.setTab('contracts')">Warranty &amp; AMC</button>
                            <button t-att-class="state.tab === 'health' ? 'active' : ''" t-on-click="() => this.setTab('health')">Health &amp; Inspection</button>
                            <button t-att-class="state.tab === 'operations' ? 'active' : ''" t-on-click="() => this.setTab('operations')">Transfer &amp; Disposal</button>
                            <button t-att-class="state.tab === 'financial' ? 'active' : ''" t-on-click="() => this.setTab('financial')">Financial</button>
                            <button t-att-class="state.tab === 'lifecycle' ? 'active' : ''" t-on-click="() => this.setTab('lifecycle')">Lifecycle</button>
                            <button t-att-class="state.tab === 'documents' ? 'active' : ''" t-on-click="() => this.setTab('documents')">Documents</button>
                        </div>
                    </div>

                    <div class="o_am_card" t-if="state.tab === 'overview'">
                        <div class="row g-2">
                            <div class="col-md-6">Classification: <b t-esc="displayPair(state.data.fms_classification_id)"/></div>
                            <div class="col-md-6">Manufacturer: <b t-esc="state.data.fms_manufacturer or '—'"/></div>
                            <div class="col-md-6">Model: <b t-esc="state.data.model or '—'"/></div>
                            <div class="col-md-6">Serial: <b t-esc="state.data.serial_no or '—'"/></div>
                            <div class="col-md-6">Health score: <b t-esc="state.data.fms_health_score or '—'"/></div>
                            <div class="col-md-6">Owner: <b t-esc="displayPair(state.data.owner_user_id)"/></div>
                        </div>
                        <div class="mt-3" t-if="!state.data.fms_operations_locked">
                            <h4>QR / Barcode</h4>
                            <p>Token: <code t-esc="state.data.fms_qr_token or '—'"/></p>
                            <p>Barcode: <b t-esc="state.data.fms_barcode or '—'"/></p>
                            <button class="o_am_btn" t-att-disabled="state.saving" t-on-click="regenerateQr">Regenerate QR Token</button>
                        </div>
                        <p t-if="state.data.fms_operations_locked" class="text-muted mt-2">This asset is disposed; operational changes are locked.</p>
                    </div>

                    <div class="o_am_card" t-if="state.tab === 'assignment'">
                        <p><b>Location:</b> <t t-esc="displayPair(state.data.fms_location_id)"/></p>
                        <p class="text-muted small">Maintenance field: <t t-esc="state.data.location or '—'"/></p>
                        <h4 class="mt-3">Current assignment</h4>
                        <t t-if="state.data.assignment">
                            <p><b>Type:</b> <t t-esc="state.data.assignment.assignment_type"/></p>
                            <p><b>Assigned to:</b> <t t-esc="displayPair(state.data.assignment.assigned_user_id)"/></p>
                            <p><b>Department:</b> <t t-esc="state.data.assignment.department or '—'"/></p>
                        </t>
                        <p t-else="" class="text-muted">No active assignment.</p>

                        <div t-if="!state.data.fms_operations_locked" class="o_am_form mt-3">
                            <h4>New assignment</h4>
                            <select t-model="state.assignmentForm.assignment_type">
                                <option value="employee">Employee</option>
                                <option value="department">Department</option>
                                <option value="team">Team</option>
                                <option value="operations_group">Facility Operations Group</option>
                            </select>
                            <label>Assign to user</label>
                            <select t-model="state.assignmentForm.assigned_user_id">
                                <option value="">—</option>
                                <option t-foreach="state.userOptions" t-as="u" t-key="u.id" t-att-value="u.id" t-esc="u.label"/>
                            </select>
                            <label>Department</label>
                            <input type="text" t-model="state.assignmentForm.department"/>
                            <input type="date" t-model="state.assignmentForm.assignment_date"/>
                            <textarea rows="2" t-model="state.assignmentForm.notes"/>
                            <button class="o_am_btn primary mt-2" t-att-disabled="state.saving" t-on-click="submitAssignment">Assign</button>
                        </div>
                        <h4 class="mt-4">Assignment history</h4>
                        <table class="o_am_table" t-if="state.data.assignment_history.length">
                            <thead><tr><th>Date</th><th>Event</th><th>User</th><th>Notes</th></tr></thead>
                            <tbody>
                                <tr t-foreach="state.data.assignment_history" t-as="row" t-key="row.id">
                                    <td t-esc="row.event_date"/>
                                    <td t-esc="row.event_type"/>
                                    <td t-esc="displayPair(row.assigned_user_id)"/>
                                    <td t-esc="row.notes or ''"/>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="o_am_card" t-if="state.tab === 'contracts'">
                        <h4>Warranties</h4>
                        <table class="o_am_table" t-if="state.data.warranties.length">
                            <thead><tr><th>Name</th><th>Status</th><th>End</th></tr></thead>
                            <tbody>
                                <tr t-foreach="state.data.warranties" t-as="row" t-key="row.id">
                                    <td t-esc="row.name"/>
                                    <td t-esc="row.status"/>
                                    <td t-esc="row.end_date or '—'"/>
                                </tr>
                            </tbody>
                        </table>
                        <p t-else="" class="text-muted">No warranty records.</p>
                        <div t-if="!state.data.fms_operations_locked" class="o_am_form mt-3">
                            <h4>Add warranty</h4>
                            <input type="text" t-model="state.warrantyForm.name" placeholder="Name"/>
                            <input type="date" t-model="state.warrantyForm.end_date" placeholder="End date"/>
                            <button class="o_am_btn primary mt-2" t-att-disabled="state.saving" t-on-click="submitWarranty">Save warranty</button>
                        </div>
                        <h4 class="mt-4">AMC contracts</h4>
                        <table class="o_am_table" t-if="state.data.amc_contracts.length">
                            <thead><tr><th>Name</th><th>Status</th><th>End</th></tr></thead>
                            <tbody>
                                <tr t-foreach="state.data.amc_contracts" t-as="row" t-key="row.id">
                                    <td t-esc="row.name"/>
                                    <td t-esc="row.status"/>
                                    <td t-esc="row.contract_end_date or '—'"/>
                                </tr>
                            </tbody>
                        </table>
                        <p t-else="" class="text-muted">No AMC records.</p>
                        <div t-if="!state.data.fms_operations_locked" class="o_am_form mt-3">
                            <h4>Add AMC</h4>
                            <input type="text" t-model="state.amcForm.name" placeholder="Name"/>
                            <input type="date" t-model="state.amcForm.contract_end_date"/>
                            <button class="o_am_btn primary mt-2" t-att-disabled="state.saving" t-on-click="submitAmc">Save AMC</button>
                        </div>
                    </div>

                    <div class="o_am_card" t-if="state.tab === 'health'">
                        <table class="o_am_table" t-if="state.data.inspections.length">
                            <thead><tr><th>Name</th><th>State</th><th>Date</th><th>Condition</th><th>Health</th></tr></thead>
                            <tbody>
                                <tr t-foreach="state.data.inspections" t-as="row" t-key="row.id">
                                    <td t-esc="row.name"/>
                                    <td t-esc="row.state"/>
                                    <td t-esc="row.inspection_date"/>
                                    <td t-esc="row.condition or '—'"/>
                                    <td t-esc="row.health_status or '—'"/>
                                </tr>
                            </tbody>
                        </table>
                        <p t-else="" class="text-muted">No inspections yet.</p>
                        <div t-if="!state.data.fms_operations_locked" class="o_am_form mt-3">
                            <h4>Record inspection</h4>
                            <input type="text" t-model="state.inspectionForm.name"/>
                            <select t-model="state.inspectionForm.condition">
                                <option value="excellent">Excellent</option>
                                <option value="good">Good</option>
                                <option value="fair">Fair</option>
                                <option value="poor">Poor</option>
                            </select>
                            <select t-model="state.inspectionForm.health_status">
                                <option value="healthy">Healthy</option>
                                <option value="attention">Attention</option>
                                <option value="degraded">Degraded</option>
                            </select>
                            <input type="number" step="0.1" t-model="state.inspectionForm.health_score" placeholder="Health score (0–100)"/>
                            <textarea rows="2" t-model="state.inspectionForm.observations"/>
                            <button class="o_am_btn primary mt-2" t-att-disabled="state.saving" t-on-click="submitInspection">Complete inspection</button>
                        </div>
                    </div>

                    <div class="o_am_card" t-if="state.tab === 'operations'">
                        <h4>Transfers</h4>
                        <table class="o_am_table" t-if="state.data.transfers.length">
                            <thead><tr><th>Reference</th><th>State</th><th>Scheduled</th></tr></thead>
                            <tbody>
                                <tr t-foreach="state.data.transfers" t-as="row" t-key="row.id">
                                    <td t-esc="row.name"/>
                                    <td t-esc="row.state"/>
                                    <td t-esc="row.scheduled_transfer_date or '—'"/>
                                </tr>
                            </tbody>
                        </table>
                        <p t-else="" class="text-muted">No transfer requests.</p>
                        <div t-if="!state.data.fms_operations_locked" class="o_am_form mt-3">
                            <h4>Request transfer</h4>
                            <label>To location (room)</label>
                            <select t-model="state.transferForm.to_location_id">
                                <option value="">—</option>
                                <option t-foreach="state.locationOptions" t-as="loc" t-key="loc.id" t-att-value="loc.id" t-esc="loc.label"/>
                            </select>
                            <textarea rows="2" t-model="state.transferForm.reason" placeholder="Reason"/>
                            <button class="o_am_btn primary mt-2" t-att-disabled="state.saving" t-on-click="submitTransfer">Submit transfer</button>
                        </div>
                        <h4 class="mt-4">Disposals</h4>
                        <table class="o_am_table" t-if="state.data.disposals.length">
                            <thead><tr><th>Reference</th><th>State</th><th>Date</th></tr></thead>
                            <tbody>
                                <tr t-foreach="state.data.disposals" t-as="row" t-key="row.id">
                                    <td t-esc="row.name"/>
                                    <td t-esc="row.state"/>
                                    <td t-esc="row.disposal_date or '—'"/>
                                </tr>
                            </tbody>
                        </table>
                        <p t-else="" class="text-muted">No disposal requests.</p>
                        <div t-if="!state.data.fms_operations_locked" class="o_am_form mt-3">
                            <h4>Request disposal</h4>
                            <select t-model="state.disposalForm.disposal_reason">
                                <option value="end_of_life">End of Life</option>
                                <option value="damaged">Damaged Beyond Repair</option>
                                <option value="obsolete">Obsolete</option>
                                <option value="sold">Sold</option>
                                <option value="other">Other</option>
                            </select>
                            <textarea rows="2" t-model="state.disposalForm.remarks"/>
                            <button class="o_am_btn danger mt-2" t-att-disabled="state.saving" t-on-click="submitDisposal">Submit disposal</button>
                        </div>
                    </div>

                    <div class="o_am_card" t-if="state.tab === 'financial'">
                        <div class="row g-2 mb-3">
                            <div class="col-md-4">Acquisition cost: <b t-esc="state.data.cost"/></div>
                            <div class="col-md-4">Book value: <b t-esc="state.data.fms_book_value"/></div>
                            <div class="col-md-4">Accumulated depreciation: <b t-esc="state.data.fms_accumulated_depreciation"/></div>
                            <div class="col-md-4">Residual value: <b t-esc="state.data.fms_residual_value"/></div>
                            <div class="col-md-4">Useful life (months): <b t-esc="state.data.fms_useful_life_months or '—'"/></div>
                            <div class="col-md-4">Method: <b t-esc="state.data.fms_depreciation_method or '—'"/></div>
                        </div>
                        <t t-if="state.data.depreciation">
                            <h4>Active schedule</h4>
                            <p class="small text-muted">
                                Status <b t-esc="state.data.depreciation.state"/> ·
                                Pending <b t-esc="state.data.depreciation.pending_amount"/>
                            </p>
                            <button class="o_am_btn primary me-2" t-att-disabled="state.saving" t-on-click="postDueDepreciation">Post due periods</button>
                            <table class="o_am_table mt-3" t-if="state.data.depreciation.lines.length">
                                <thead><tr><th>#</th><th>Period</th><th>Amount</th><th>Status</th><th>JE Ref</th></tr></thead>
                                <tbody>
                                    <tr t-foreach="state.data.depreciation.lines" t-as="line" t-key="line.id">
                                        <td t-esc="line.period_number"/>
                                        <td t-esc="line.period_date"/>
                                        <td t-esc="line.depreciation_amount"/>
                                        <td t-esc="line.state"/>
                                        <td t-esc="line.journal_entry_ref or '—'"/>
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                        <div t-elif="!state.data.fms_operations_locked and state.data.cost" class="o_am_form mt-2">
                            <h4>Create depreciation schedule</h4>
                            <label class="d-flex gap-2 align-items-center">
                                <input type="checkbox" t-model="state.depreciationForm.auto_generate"/>
                                Generate monthly lines now
                            </label>
                            <button class="o_am_btn primary mt-2" t-att-disabled="state.saving" t-on-click="createDepreciationSchedule">Create schedule</button>
                        </div>
                        <p t-elif="!state.data.cost" class="text-muted">Set acquisition cost on the asset before creating a schedule.</p>
                    </div>

                    <div class="o_am_card" t-if="state.tab === 'lifecycle'">
                        <table class="o_am_table" t-if="state.data.lifecycle_events.length">
                            <thead><tr><th>Date</th><th>Type</th><th>Summary</th><th>User</th></tr></thead>
                            <tbody>
                                <tr t-foreach="state.data.lifecycle_events" t-as="ev" t-key="ev.id">
                                    <td t-esc="ev.event_date"/>
                                    <td t-esc="ev.event_type"/>
                                    <td t-esc="ev.summary"/>
                                    <td t-esc="displayPair(ev.user_id)"/>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="o_am_card" t-if="state.tab === 'documents'">
                        <p>Linked attachments: <b t-esc="state.data.fms_document_count"/></p>
                        <p class="text-muted">Upload documents using the backend asset form or mail chatter. Print labels from the backend report.</p>
                    </div>
                </t>
            </AmAppShell>
        </div>
    </t>
</templates>