<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_fms_asset_code" model="ir.sequence">
        <field name="name">FMS Asset ID</field>
        <field name="code">fms.asset.code</field>
        <field name="prefix">AST/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_fms_asset_transfer" model="ir.sequence">
        <field name="name">FMS Asset Transfer</field>
        <field name="code">fms.asset.transfer</field>
        <field name="prefix">ATR/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_fms_asset_disposal" model="ir.sequence">
        <field name="name">FMS Asset Disposal</field>
        <field name="code">fms.asset.disposal</field>
        <field name="prefix">ADP/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>