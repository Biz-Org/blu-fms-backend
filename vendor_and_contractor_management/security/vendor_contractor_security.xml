<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_vendor_contractor" model="ir.module.category">
        <field name="name">Vendor &amp; Contractor</field>
        <field name="sequence">48</field>
    </record>

    <record id="group_vc_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_vendor_contractor"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_vc_supervisor" model="res.groups">
        <field name="name">Supervisor</field>
        <field name="category_id" ref="module_category_vendor_contractor"/>
        <field name="implied_ids" eval="[(4, ref('group_vc_user'))]"/>
    </record>

    <record id="group_vc_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_vendor_contractor"/>
        <field name="implied_ids" eval="[(4, ref('group_vc_supervisor'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Multi-company record rules -->
    <record id="rule_vc_vendor_company" model="ir.rule">
        <field name="name">VC Vendor multi-company</field>
        <field name="model_id" ref="model_vc_vendor"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_vc_contractor_company" model="ir.rule">
        <field name="name">VC Contractor multi-company</field>
        <field name="model_id" ref="model_vc_contractor"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_vc_worker_company" model="ir.rule">
        <field name="name">VC Worker multi-company</field>
        <field name="model_id" ref="model_vc_worker"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_vc_contract_company" model="ir.rule">
        <field name="name">VC Contract multi-company</field>
        <field name="model_id" ref="model_vc_contract"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_vc_document_company" model="ir.rule">
        <field name="name">VC Document multi-company</field>
        <field name="model_id" ref="model_vc_document"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_vc_activity_company" model="ir.rule">
        <field name="name">VC Activity multi-company</field>
        <field name="model_id" ref="model_vc_activity"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
