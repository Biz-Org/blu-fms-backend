<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_housekeeping" model="ir.module.category">
        <field name="name">Housekeeping</field>
        <field name="sequence">45</field>
    </record>

    <record id="group_hk_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_housekeeping"/>
    </record>

    <record id="group_hk_supervisor" model="res.groups">
        <field name="name">Supervisor</field>
        <field name="category_id" ref="module_category_housekeeping"/>
        <field name="implied_ids" eval="[(4, ref('group_hk_user'))]"/>
    </record>

    <record id="group_hk_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_housekeeping"/>
        <field name="implied_ids" eval="[(4, ref('group_hk_supervisor'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin')), (4, ref('base.user_root'))]"/>
    </record>

    <record id="group_hk_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_housekeeping"/>
        <field name="implied_ids" eval="[(4, ref('group_hk_manager'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin')), (4, ref('base.user_root'))]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_hk_admin'))]"/>
    </record>

    <record id="rule_hk_task_user_own" model="ir.rule">
        <field name="name">HK Task: user own/assigned</field>
        <field name="model_id" ref="model_hk_task"/>
        <field name="domain_force">['|', ('staff_id.user_id', '=', user.id), ('staff_id', '=', False)]</field>
        <field name="groups" eval="[(4, ref('group_hk_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_hk_task_supervisor_all" model="ir.rule">
        <field name="name">HK Task: supervisor all</field>
        <field name="model_id" ref="model_hk_task"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_hk_supervisor'))]"/>
    </record>
</odoo>
